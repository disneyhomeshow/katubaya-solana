# Copy to .env.local and adjust. Every value is optional; these are the defaults.

# Solana cluster the DApp talks to: devnet, testnet, mainnet-beta or localnet.
VITE_SOLANA_CLUSTER=devnet
# RPC endpoint. Defaults to the public endpoint of VITE_SOLANA_CLUSTER (http://127.0.0.1:8899 for localnet).
# VITE_RPC_URL=https://api.devnet.solana.com

# Symbols for payment mints, as a JSON object of mint address -> symbol.
# Mints not listed here show as a shortened address.
VITE_MINT_SYMBOLS={"4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU":"USDC","EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v":"USDC"}
